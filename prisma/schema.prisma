generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum QuoteStatus {
  DRAFT
  PRICED
  EXPIRED
  CONVERTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  LABEL_PURCHASED
  ADJUSTMENT_PENDING
  COMPLETED
  VOID_REQUESTED
  VOIDED
  REFUNDED
  FAILED
}

enum CarrierCode {
  UPS
  FEDEX
}

enum AdjustmentStatus {
  PENDING
  BILLED
  PAID
  FAILED
  WAIVED
}

enum OrderPaymentSource {
  STRIPE
  WALLET
}

enum WalletTransactionType {
  TOP_UP
  LABEL_PURCHASE
  VOID_REFUND
  MANUAL_CREDIT
  MANUAL_DEBIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum BatchPurchaseStatus {
  COMPLETED
  FAILED
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  passwordHash         String
  name                 String
  companyName          String?
  role                 UserRole            @default(CUSTOMER)
  stripeCustomerId     String?
  defaultPaymentMethod String?
  walletBalance        Decimal             @default(0) @db.Decimal(12, 2)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  pricingProfile       PricingProfile?
  savedAddresses       SavedAddress[]
  quotes               Quote[]
  orders               Order[]
  walletTransactions   WalletTransaction[]
  batchPurchases       BatchPurchase[]
  adjustmentCharges    CarrierAdjustment[] @relation("CustomerAdjustments")
}

model PricingProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  markupPercent        Decimal  @db.Decimal(6, 3)
  flatFee              Decimal  @default(0) @db.Decimal(10, 2)
  minimumProfit        Decimal  @default(0) @db.Decimal(10, 2)
  residentialSurcharge Decimal  @default(0) @db.Decimal(10, 2)
  signatureSurcharge   Decimal  @default(0) @db.Decimal(10, 2)
  enabled              Boolean  @default(true)
  allowUps             Boolean  @default(true)
  allowFedex           Boolean  @default(true)
  allowUpsPurchase     Boolean  @default(true)
  allowFedexPurchase   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedAddress {
  id          String   @id @default(cuid())
  userId      String
  label       String
  name        String
  company     String?
  phone       String?
  email       String?
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  countryCode String   @default("US")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Quote {
  id                 String      @id @default(cuid())
  userId             String
  status             QuoteStatus @default(DRAFT)
  shipFromPostalCode String
  shipToPostalCode   String
  shipDate           DateTime?
  packageLength      Decimal     @db.Decimal(10, 2)
  packageWidth       Decimal     @db.Decimal(10, 2)
  packageHeight      Decimal     @db.Decimal(10, 2)
  packageWeight      Decimal     @db.Decimal(10, 2)
  declaredValue      Decimal     @default(0) @db.Decimal(10, 2)
  residential        Boolean     @default(false)
  signatureRequired  Boolean     @default(false)
  shipmentJson       Json?
  ratesJson          Json?
  createdAt          DateTime    @default(now())
  expiresAt          DateTime?
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             Order[]
}

model Order {
  id                    String             @id @default(cuid())
  userId                String
  quoteId               String
  status                OrderStatus        @default(PENDING_PAYMENT)
  paymentSource         OrderPaymentSource @default(STRIPE)
  selectedCarrier       CarrierCode
  selectedService       String
  quotedCustomerAmount  Decimal            @db.Decimal(10, 2)
  quotedCarrierAmount   Decimal            @db.Decimal(10, 2)
  actualCarrierAmount   Decimal?           @db.Decimal(10, 2)
  marginAmount          Decimal            @db.Decimal(10, 2)
  walletDebitedAmount   Decimal            @default(0) @db.Decimal(10, 2)
  shipmentJson          Json?
  selectedRateJson      Json?
  trackingNumber        String?
  labelUrl              String?
  stripePaymentIntentId String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote                 Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  adjustments           CarrierAdjustment[]
  walletTransactions    WalletTransaction[]
}

model CarrierAdjustment {
  id                   String           @id @default(cuid())
  orderId              String
  customerId           String
  carrierCode          CarrierCode
  reason               String
  originalQuotedAmount Decimal          @db.Decimal(10, 2)
  carrierBilledAmount  Decimal          @db.Decimal(10, 2)
  amountToCharge       Decimal          @db.Decimal(10, 2)
  status               AdjustmentStatus @default(PENDING)
  stripeInvoiceItemId  String?
  createdAt            DateTime         @default(now())
  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer             User             @relation("CustomerAdjustments", fields: [customerId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id                    String                  @id @default(cuid())
  userId                String
  orderId               String?
  type                  WalletTransactionType
  status                WalletTransactionStatus @default(PENDING)
  amount                Decimal                 @db.Decimal(10, 2)
  balanceBefore         Decimal                 @db.Decimal(12, 2)
  balanceAfter          Decimal                 @db.Decimal(12, 2)
  description           String
  stripePaymentIntentId String?                 @unique
  metadataJson          Json?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order                 Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([orderId, createdAt])
}

model BatchPurchase {
  id             String              @id @default(cuid())
  userId         String
  fingerprint    String
  rowCount       Int
  totalAmount    Decimal             @db.Decimal(10, 2)
  status         BatchPurchaseStatus
  sourceCsv      String?
  retryOfBatchId String?
  resultJson     Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fingerprint])
  @@index([userId, createdAt])
}
